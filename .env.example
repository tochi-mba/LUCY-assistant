# The hub's configuration. Copy to .env for local development.
#
# Every variable here is a fact about THIS MACHINE. A fact about a person -- which model
# they prefer, how much context goes to memory, whether a destructive tool may run without
# asking -- belongs in settings-api under the `lucy` namespace, not here.
#
# An unknown LUCY_* variable is a startup error, not a warning. That is deliberate: this
# process holds the address of every other service, and a typo in one of them would
# otherwise produce a process that looks healthy until the first call fails.

LUCY_ENVIRONMENT=local
LUCY_HOST=127.0.0.1
LUCY_PORT=8000
LUCY_LOG_LEVEL=INFO
LUCY_LOG_FORMAT=console

# Every conversation lives in this one SQLite file. `:memory:` is accepted and is what
# the tests use; the parent directory is created on first open.
LUCY_DATABASE_PATH=var/lucy.sqlite3

# Uploaded files and session artifacts. Empty means a `blobs` directory beside the
# database, or a process-owned temp tree when the database is `:memory:`.
LUCY_BLOBS_PATH=

# Identity. LUCY_AUDIENCE must equal this service's name in keyring's
# KEYRING_SERVICE_TOKENS and its audience_prefix in settings-api's SETTINGS_API_SERVICES.
# A mismatch fails closed and looks exactly like a correct config whose every call is 401.
LUCY_AUDIENCE=lucy-api
LUCY_KEYRING_BASE_URL=http://127.0.0.1:8001
LUCY_KEYRING_JWKS_URL=http://127.0.0.1:8001/.well-known/jwks.json
LUCY_KEYRING_ISSUER=http://127.0.0.1:8001
# From scripts/genenv.py. Never commit a real one.
LUCY_KEYRING_SERVICE_TOKEN=

# Optional model-provider credentials. Leave everything empty to run setup and inspect
# sessions; readiness then reports that no conversational provider is available.
#
# LUCY_MODEL_KEYS is one key per provider id, as JSON: `GET /v1/models` and `lucy models`
# list every id the hub knows and what each one needs. A local runtime has no key; naming
# it with any value switches it on. `lucy models connect <provider>` writes this line.
# The two named keys below predate the mapping and are folded into it.
LUCY_MODEL_KEYS='{}'
LUCY_OPENAI_API_KEY=
LUCY_ANTHROPIC_API_KEY=
# Overrides a provider's endpoint: a cloud tenant, a runtime on another port, a proxy.
# Required for the rows that have no public endpoint (azure-openai, bedrock).
LUCY_MODEL_BASE_URLS='{}'

# The rest of the family.
LUCY_USER_API_BASE_URL=http://127.0.0.1:8002
LUCY_SETTINGS_API_BASE_URL=http://127.0.0.1:8003
LUCY_SETTINGS_API_TOKEN=
LUCY_PERSONA_API_BASE_URL=http://127.0.0.1:8004
LUCY_WEB_SEARCH_BASE_URL=http://127.0.0.1:8006
LUCY_SPOTIFY_API_BASE_URL=http://127.0.0.1:8007
LUCY_ENVIRONMENTS_API_BASE_URL=http://127.0.0.1:8008
LUCY_MEMORY_API_BASE_URL=http://127.0.0.1:8009
# Lucy's entry in Memory-api's MEMORY_SERVICE_TOKENS. Empty refuses every notes call.
LUCY_MEMORY_API_TOKEN=

# Optional extra capability. Leave empty unless this deployment wires one.
# Port 8005 is reserved for an operator-local service (docker-compose.override.yml).
LUCY_MEDIA_BASE_URL=
LUCY_MEDIA_AUDIENCE=media

LUCY_JWKS_CACHE_SECONDS=3600
LUCY_JWKS_MIN_REFETCH_SECONDS=30
LUCY_HTTP_TIMEOUT_SECONDS=10
