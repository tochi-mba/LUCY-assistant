{
  "folders": [
    { "name": "family", "path": "." },
    { "name": "Keyring-api", "path": "Keyring-api" },
    { "name": "Settings-api", "path": "Settings-api" },
    { "name": "User-api", "path": "User-api" },
    { "name": "Persona-api", "path": "Persona-api" },
    { "name": "Web-search-api", "path": "Web-search-api" },
    { "name": "Spotify-api", "path": "Spotify-api" },
    { "name": "Environments-api", "path": "Environments-api" },
    { "name": "Memory-api", "path": "Memory-api" }
  ],
  "settings": {
    "git.autoRepositoryDetection": "subFolders",
    "git.repositoryScanMaxDepth": 2,
    "git.openRepositoryInParentFolders": "never",
    "git.scanRepositories": [
      "Keyring-api",
      "Settings-api",
      "User-api",
      "Persona-api",
      "Web-search-api",
      "Spotify-api",
      "Environments-api",
      "Memory-api"
    ],
    "scm.repositories.visible": 20,
    "editor.formatOnSave": true,
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "[python]": {
      "editor.defaultFormatter": "charliermarsh.ruff",
      "editor.codeActionsOnSave": {
        "source.fixAll.ruff": "explicit",
        "source.organizeImports.ruff": "explicit"
      }
    },
    "[yaml]": {
      "editor.tabSize": 2,
      "editor.insertSpaces": true
    },
    "ruff.nativeServer": "on",
    "mypy-type-checker.importStrategy": "fromEnvironment",
    "mypy-type-checker.preferDaemon": true
  },
  "extensions": {
    "recommendations": [
      "charliermarsh.ruff",
      "ms-python.mypy-type-checker",
      "ms-python.python",
      "editorconfig.editorconfig"
    ]
  }
}
