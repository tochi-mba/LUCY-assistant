# The service repositories are separate git repositories. scripts/bootstrap.sh
# clones them here from repos.txt (+ optional repos.local.txt); they are never
# part of this repository.
/Keyring-api/
/Settings-api/
/User-api/
/Persona-api/
/Web-search-api/
/Spotify-api/
/Environments-api/
/Memory-api/

# Operator-local sibling checkouts and the compose/token extras that wire them.
# See docs/private-repos.md and docs/adr/0011-private-services-are-extensions.md.
#
# The manifest itself is ignored, and that is the load-bearing line: it is the one file
# that lists private repository names, so committing it would publish exactly what every
# other rule here exists to keep private. `.repos.local.txt.example` is the committed
# template and names nothing. Bootstrap additionally writes each private checkout's
# directory name into .git/info/exclude, which is per-clone and never committed -- naming
# those directories here would leak them the same way.
/private/
/.repos.local.txt
/repos.local.txt
*.local.code-workspace
/docker-compose.local.yml
/docker-compose.override.yml
/scripts/genenv.local.json

# Secrets generated for docker compose by scripts/genenv.py. Never commit them.
.env.family
.env

# Logs, including bootstrap's per-repository logs
*.log
/.logs/

# The hub's SQLite database, wherever LUCY_DATABASE_PATH puts it by default.
var/

# Caches and test output
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.import_linter_cache/
.venv/
.coverage
coverage.xml
junit.xml
htmlcov/

# Token-broker development and deployment state
/broker/node_modules/
/broker/.wrangler/
